rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.uid == 'admin_session_id' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Access Codes collection
    match /accessCodes/{codeId} {
      allow read: if true; // Publicly queryable for code verification
      allow create, update, delete: if isAdmin();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true; // Allowed for authenticated admins or valid session users
      
      // Update rules:
      // - Max 3 edits enforced
      // - Sender can edit text or soft-delete
      // - Admin can pin/unpin or soft-delete
      allow update: if (
        // Case 1: Admin moderation (pin, soft delete)
        isAdmin() ||
        // Case 2: Message owner editing text (max 3 edits)
        (
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.editCount <= 3 &&
          request.resource.data.editCount == resource.data.editCount + 1
        ) ||
        // Case 3: Message owner soft deleting
        (
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.deleted == true
        )
      );

      allow delete: if isAdmin();
    }

    // Pinned messages collection
    match /pinnedMessages/{pinId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
